Algoritmo "Tempo em segundos"
Var
   h,m,s,ts: real



Inicio
      Escreval("Digite o valor em horas,minutos e segundos, respectivamente, para saber o total em segundos")
      leia(h,m,s)
      ts <- h*3600+m*60+s
      escreval("O TEMPO EM SEGUNDOS EM SEGUNDOS É: ", ts)



Fimalgoritmo
