Algoritmo "Divisível por 3 e 5"

Var
   n: inteiro

Inicio
      escreva("Digite um número inteiro: ")
      leia(n)
      se (n%3=0) e (n%5=0) entao
         escreval("O número é divisível por 3 e 5")
      senao
         escreval("O número não é divisível por 3 e 5")
      fimse

Fimalgoritmo
