Algoritmo "Conversões para o Sistema Métrico"

Var
    tempF,pol,tempC,mm: real


Inicio
      escreval("Dê um valor em temperatura Fahrenheit e outra em polegada.")
      leia(tempF,pol)
      tempC <- (5*tempF - 160)/9)
      mm <- pol*25.4
      escreval ("O VALOR EM CELSIUS É: ", tempC:1:2)
      escreval("A QUANTIDADE DE CHUVA É: ", mm:1:2)
      


Fimalgoritmo
