Algoritmo "Cálculo do Delta na Equação de Báskara"

Var
   a,b,c,delta:real


Inicio
      escrevaL("Digite os 3 coeficientes, em ordem (a,b,c), para calcular o discriminante (delta): ")
      leia (a,b,c)
      delta <- b^2 - 4*a*c
      escreva ("O VALOR DE DELTA É ", delta:1:2)
      

Fimalgoritmo